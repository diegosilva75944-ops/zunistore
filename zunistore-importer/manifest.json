{
  "manifest_version": 3,
  "name": "ZuniStore Importer",
  "version": "1.1.0",
  "description": "Captura a URL do produto no Mercado Livre e envia para importação no ZuniStore (servidor).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.mercadolivre.com.br/*"],
  "action": {
    "default_title": "ZuniStore Importer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
