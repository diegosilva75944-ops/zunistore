{
  "name": "zunistore",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "start:x11": "bash scripts/run.sh",
    "lint": "eslint",
    "test": "vitest run",
    "replace": "node scripts/replace-all.js",
    "postinstall": "node scripts/postinstall-playwright.js",
    "test:playwright": "node scripts/test-playwright.js",
    "ml:login": "node scripts/ml-login.js",
    "ml:login:env": "node -e \"console.log('ML_PLAYWRIGHT_USER_DATA_DIR=.playwright/ml-user-data'); console.log('ML_PLAYWRIGHT_STORAGE_STATE=.playwright/ml-storage-state.json'); console.log('ML_PLAYWRIGHT_HEADLESS=0  (opcional, janela sempre visível)'); console.log('ML_PLAYWRIGHT_HEADED_ON_BLOCK=1  (abre janela só se headless falhar por bloqueio/login)'); console.log('ML_PLAYWRIGHT_INTERACTIVE_TIMEOUT_MS=300000  (5 min ao aguardar desbloqueio)');\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "bcryptjs": "^3",
    "cheerio": "^1.2.0",
    "clsx": "^2",
    "jose": "^6",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "playwright": "^1.51.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3",
    "zod": "^4"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.31.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
