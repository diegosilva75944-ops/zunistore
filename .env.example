# Em produção use a URL pública (https://seu-dominio) para OG, compartilhamento e canonical.
# Se o proxy não enviar X-Forwarded-Host, sem isso pode aparecer IP interno do container nas URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API de dados: PostgreSQL exposto via PostgREST (não é obrigatório usar o produto Supabase).
# Prioridade da URL base: POSTGREST_URL → DB_API_URL → SUPABASE_URL (nomes SUPABASE_* são aliases).
# Ex.: PostgREST na raiz: http://postgrest:3000  |  Atrás de /rest/v1: https://seu-dominio/rest/v1
# POSTGREST_URL=http://localhost:3001
SUPABASE_URL=http://localhost:3001
# Chave anon do Supabase: JWT com 3 segmentos (eyJ… … …). Sem prefixo "Bearer ". Se aparecer PGRST301, não use chave sb_publishable_* — use a anon JWT em Settings → API.
SUPABASE_ANON_KEY=replace-with-your-anon-or-public-api-key
# Obrigatório no servidor para admin (sincronizar preço, PATCH, histórico): a anon só tem SELECT (RLS).
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-api-key

# Conexão direta com Postgres (para tabelas sensíveis, ex.: mercadolivre_tokens)
# Formato: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgres://user:pass@localhost:5432/postgres

# Alternativa com aliases (opcional)
# DB_API_URL=http://localhost:3001
# DB_ANON_KEY=replace-with-your-anon-or-public-api-key
# DB_SERVICE_ROLE_KEY=replace-with-your-service-api-key

# Admin cookie session (HS256) - mínimo 32 chars
ADMIN_JWT_SECRET=replace-with-random-64-char-secret
ADMIN_JWT_COOKIE_NAME=zuni_admin

# Cron: validação de links de afiliado em /api/cron/validate-affiliate-links
# Use o mesmo valor no curl: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-long-random-string

# App Flutter (worker): mesma chave no app (Configurações) e header Authorization: Bearer ...
# Gere uma string longa aleatória (mín. 16 caracteres no código).
# MOBILE_APP_API_KEY=replace-with-long-random-mobile-key

# Produção/container — não copie estas linhas para .env.local ao desenvolver com `next dev`
# (o Next.js define NODE_ENV ao arrancar).
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1

# Mercado Livre — Playwright (importação / sync no servidor; requer display se usar janela visível)
# ML_PLAYWRIGHT_USER_DATA_DIR=.playwright/ml-user-data
# ML_PLAYWRIGHT_HEADLESS=1
# Com `next dev`, por defeito abre janela se o ML bloquear (account-verification/login). Em produção ou `next start` use 1 para forçar.
# ML_PLAYWRIGHT_HEADED_ON_BLOCK=0
# Tempo máximo (ms) a esperar login/captcha no modo interativo (mín. 10000)
# ML_PLAYWRIGHT_INTERACTIVE_TIMEOUT_MS=300000
