# Em produção use a URL pública (https://seu-dominio) para OG, compartilhamento e canonical.
# Se o proxy não enviar X-Forwarded-Host, sem isso pode aparecer IP interno do container nas URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API de dados (PostgREST/Supabase API)
# Compatibilidade antiga:
# - SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# Compatibilidade nova (self-hosted):
# - DB_API_URL / DB_ANON_KEY / DB_SERVICE_ROLE_KEY (ou DB_SERVICE_KEY)
SUPABASE_URL=http://localhost:3001
SUPABASE_ANON_KEY=replace-with-your-anon-or-public-api-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-api-key

# Alternativa com aliases (opcional)
# DB_API_URL=http://localhost:3001
# DB_ANON_KEY=replace-with-your-anon-or-public-api-key
# DB_SERVICE_ROLE_KEY=replace-with-your-service-api-key

# Admin cookie session (HS256) - mínimo 32 chars
ADMIN_JWT_SECRET=replace-with-random-64-char-secret
ADMIN_JWT_COOKIE_NAME=zuni_admin

# Opcional para produção/container
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
